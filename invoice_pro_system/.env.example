# .env.example

# Application
APP_ENV=development
APP_NAME=InvoicePro
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DEFAULT_CURRENCY=ZAR
VAT_RATE=0.15
INVOICE_PREFIX=INV

# Business
BUSINESS_NAME=Your Business Name
BUSINESS_VAT_NUMBER=

# Database
DB_NAME=business.db
DB_TIMEOUT=30
DB_PATH=invoice_pro_system/data/business.db
ALLOW_DB_BOOTSTRAP=false
ALLOW_MANUAL_DB_MAINTENANCE=false

# Sessions
SESSION_SECRET_KEY=change-me
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=false

# Admin Bootstrap
ADMIN_EMAIL=vantapilot@gmail.com
ADMIN_PASSWORD=change-this-before-production

# Google OAuth / Gmail Sending
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback
OAUTH_TOKEN_ENCRYPTION_KEY=

# Paystack Billing
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_CODE=
PAYSTACK_PLAN_AMOUNT=19900
PAYSTACK_PLAN_NAME=Vanta Pilot Pro
PAYSTACK_PLAN_PRICE=R199
PAYSTACK_PLAN_INTERVAL=month
PAYSTACK_CURRENCY=ZAR

# Temporary restore workflow. Leave disabled unless you are deliberately restoring a DB.
ALLOW_DB_RESTORE_UPLOAD=false
DB_RESTORE_TOKEN=
